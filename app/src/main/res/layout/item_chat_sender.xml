<FrameLayout android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp"
        android:paddingHorizontal="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/head"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/speed_transfer_pink"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/triangle_tail"
            android:layout_width="5dp"
            android:layout_height="8dp"
            android:background="@drawable/ic_triangle_right"
            app:layout_constraintEnd_toStartOf="@+id/head"
            app:layout_constraintTop_toTopOf="@+id/head"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="8dp" />

        <com.loader.speedtransfer.ui.PopupTextView
            android:id="@+id/text_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_sender"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toStartOf="@+id/triangle_tail"
            app:layout_constraintTop_toTopOf="parent"
            android:breakStrategy="simple"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="0dp"
            android:maxLines="10"
            android:minLines="1"
            android:maxWidth="240dp"
            android:minWidth="40dp"
            android:minHeight="36dp"
            android:padding="8dp"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progress_send_status"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/pink"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/text_message"
            app:layout_constraintBottom_toBottomOf="@+id/text_message"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/icon_send_error"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_error"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/text_message"
            app:layout_constraintBottom_toBottomOf="@+id/text_message"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
