<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- 顶部标题栏：标题 + IP（可点击复制） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/pink"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp" />

        <TextView
            android:id="@+id/tv_NetworkAddressPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="xxx.xxx.xxx.xxx:xxxx"
            android:textColor="#FFE0E0E0"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 共享文件折叠按钮 -->
    <TextView
        android:id="@+id/tv_file_toggle_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ 共享文件 (0)"
        android:textSize="13sp"
        android:textColor="#888888"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:background="#FFFBFBFB"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- 文件列表动画容器 -->
    <FrameLayout
        android:id="@+id/file_list_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_file_toggle_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:maxHeight="200dp"
            android:background="#FFFBFBFB"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </FrameLayout>

    <!-- 聊天列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        android:background="#FFF5F5F5"
        app:layout_constraintTop_toBottomOf="@id/file_list_wrapper"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部输入栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingLeft="11dp"
        android:paddingBottom="24dp"
        android:background="@color/input_area_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/btn_add"
            layout="@layout/view_add_circle_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/editText_message"
            app:layout_constraintBottom_toBottomOf="@+id/editText_message" />

        <EditText
            android:id="@+id/editText_message"
            android:layout_width="0dp"
            android:minHeight="36dp"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:hint=""
            android:textColor="@color/black"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/btn_add"
            app:layout_constraintEnd_toStartOf="@id/btn_send"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textCursorDrawable="@drawable/input_box_cursor"
            android:layout_marginTop="6dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send"
            android:layout_width="56dp"
            android:layout_height="34dp"
            android:text="发送"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_send_disable"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="@+id/bottom_bar"
            app:layout_constraintBottom_toBottomOf="@id/editText_message"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="false" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
