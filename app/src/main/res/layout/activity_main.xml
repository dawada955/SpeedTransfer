<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <!-- 顶部标题栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/pink"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="0dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- 显示网络地址 -->
    <LinearLayout
        android:id="@+id/ll_StatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:background="#eeedf2"
        android:paddingVertical="8dp"
        >

        <!--    丑    #f3f3f5-->
        <TextView
            android:id="@+id/tv_NetworkAddressPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="xxx.xxx.xxx.xxx:xxxx"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginLeft="24dp"
            />
    </LinearLayout>

    <!-- 聊天列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        android:background="#eeedf2"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/ll_StatusBar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 底部输入栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingLeft="11dp"
        android:paddingBottom="24dp"
        android:background="@color/input_area_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/btn_add"
            layout="@layout/view_add_circle_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/editText_message"
            app:layout_constraintBottom_toBottomOf="@+id/editText_message"
            />
<!--        <ImageView-->
<!--            android:id="@+id/Iv_function"-->
<!--            android:layout_width="26dp"-->
<!--            android:layout_height="26dp"-->
<!--            android:background="@drawable/add_circle_default"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="@+id/editText_message"-->
<!--            app:layout_constraintBottom_toBottomOf="@+id/editText_message"-->
<!--            />-->

        <!-- 聊天输入框 -->
        <EditText
            android:id="@+id/editText_message"
            android:layout_width="0dp"
            android:minHeight="36dp"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:hint=""
            android:textColor="@color/black"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/btn_add"
            app:layout_constraintEnd_toStartOf="@id/btn_send"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textCursorDrawable="@drawable/input_box_cursor"
            android:layout_marginTop="6dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="10dp"/>

        <!-- 发送按钮 -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send"
            android:layout_width="56dp"
            android:layout_height="34dp"
            android:text="发送"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_send_disable"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="@+id/bottom_bar"
            app:layout_constraintBottom_toBottomOf="@id/editText_message"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="false"
        />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
